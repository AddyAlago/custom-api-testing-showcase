{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UserList",
  "type": "array",
  "items": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "User",
    "type": "object",
    "required": [
      "id",
      "name",
      "email"
    ],
    "properties": {
      "id": {
        "type": [
          "integer",
          "string"
        ]
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "email": {
        "type": "string",
        "format": "email"
      },
      "createdAt": {
        "type": [
          "string",
          "null"
        ],
        "format": "date-time"
      },
      "updatedAt": {
        "type": [
          "string",
          "null"
        ],
        "format": "date-time"
      }
    },
    "additionalProperties": true
  }
}